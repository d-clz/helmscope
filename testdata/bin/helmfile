#!/usr/bin/env bash
# Fake helmfile for tests.
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
[[ "${1:-}" == "--version" ]] && { echo "helmfile version 1.1.0-fake"; exit 0; }
echo "args: $*" >&2
out=""; cmd=""; sel=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-dir) out="$2"; shift 2 ;;
    --selector) sel="$2"; shift 2 ;;
    --file|--environment|--args) shift 2 ;;
    build|template|fetch) cmd="$1"; shift ;;
    *) shift ;;
  esac
done
case "$cmd" in
  build) cat "$here/helmfile-build.yaml" ;;
  template)
    # name the objects after the release, like a real chart would
    rel="$(printf '%s' "$sel" | sed -n 's/.*name=\([^,]*\).*/\1/p')"
    echo "Templating release=${rel:-web}" >&2
    sed "s/demo-/${rel:-demo}-/g" "$here/rendered.yaml" ;;
  fetch) mkdir -p "$out/redis-shared/redis/18.1.0"; cp -r "$here/charts/web/charts/redis" "$out/redis-shared/redis/18.1.0/" ;;
  *) echo "fake helmfile: unsupported" >&2; exit 2 ;;
esac
